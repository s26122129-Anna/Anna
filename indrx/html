        </div>
    </header>

    <!-- 全域提示訊息 Toast 容器 (取代 alert) -->
    <div id="toastContainer" class="fixed bottom-5 right-5 z-50 flex flex-col gap-2 max-w-sm w-full pointer-events-none px-4 sm:px-0"></div>

    <!-- 主內容區 -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">

        <!-- ==================== 畫面一：入口大廳 (LOBBY VIEW) ==================== -->
        <section id="lobbyView" class="max-w-4xl mx-auto">
            <!-- 標題區與視覺留白 -->
            <div class="text-center mb-10 sm:mb-14 space-y-3">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-tactical-panel border border-tactical-accent/30 text-xs font-mono text-tactical-cyan mb-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-tactical-cyan"></span>
                    CHANNEL ROUTING &amp; NEURAL SYNC
                </div>
                <h2 class="text-2xl sm:text-4xl font-bold text-white tracking-tight">建立或接入戰術頻道</h2>
                <p class="text-sm sm:text-base text-tactical-muted max-w-xl mx-auto leading-relaxed">
                    輸入您的行動代號，建立專屬房間代碼或加入指定小隊。當房主下達開牌指令時，所有終端將同步觸發 3D 翻牌驗證默契程度。
                </p>
            </div>

            <!-- 步驟 1：玩家代號設定 -->
            <div class="tactical-panel rounded-2xl p-6 sm:p-8 mb-8 max-w-xl mx-auto">
