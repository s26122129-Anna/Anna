                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-tactical-accent/20 pb-4">
                    <div class="flex items-center gap-2.5">
                        <span class="w-2.5 h-2.5 rounded-sm bg-tactical-cyan rotate-45"></span>
                        <h3 class="text-base sm:text-lg font-bold text-white tracking-wide">指揮官控制台 // COMMAND CONSOLE</h3>
                    </div>
                    <span id="stealthHostIndicator" class="hidden text-xs font-mono px-2.5 py-1 rounded bg-tactical-cyan/15 text-tactical-cyan border border-tactical-cyan/40">
                        ● 隱身房主作用中 (不參與卡牌列隊)
                    </span>
                </div>

                <!-- 出題輸入與快速題庫 -->
                <div class="space-y-3">
                    <div class="flex flex-col sm:flex-row gap-3">
                        <input type="text" id="hostQuestionInput" placeholder="輸入本回合心電感應題目（例如：提到『紅色』第一個想到的食物？）" 
