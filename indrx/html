                    <pre id="gasCodeBlock" class="bg-tactical-bg p-4 rounded-xl border border-tactical-accent/30 text-xs font-mono text-tactical-cyan overflow-x-auto leading-relaxed">const SHEET_NAME = 'TelepathyData';

function doGet(e) {
  return handleRequest(e);
}

function doPost(e) {
  return handleRequest(e);
}

function handleRequest(e) {
  const lock = LockService.getScriptLock();
  lock.tryLock(10000);
  
  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    let sheet = ss.getSheetByName(SHEET_NAME);
    if (!sheet) {
      sheet = ss.insertSheet(SHEET_NAME);
      sheet.appendRow(['RoomCode', 'PlayerId', 'PlayerName', 'IsHost', 'IsStealthHost', 'Question', 'Answer', 'Status', 'UpdatedAt']);
    }

    let params = e.parameter || {};
    if (e.postData && e.postData.contents) {
      try {
        const body = JSON.parse(e.postData.contents);
        params = Object.assign(params, body);
      } catch (err) {}
    }

    const action = params.action || 'sync';
    const roomCode = String(params.roomCode || '').toUpperCase().trim();
    const now = new Date().toISOString();
    const data = sheet.getDataRange().getValues();

    if (action === 'join' || action === 'answer') {
      let foundRow = -1;
      let currentQuestion = '等待房主發布題目...';
      let currentStatus = 'ANSWERING';

      for (let i = 1; i &lt; data.length; i++) {
        if (String(data[i][0]).toUpperCase() === roomCode) {
          if (data[i][5]) currentQuestion = data[i][5];
          if (data[i][7]) currentStatus = data[i][7];
          if (String(data[i][1]) === String(params.playerId)) {
            foundRow = i + 1;
          }
        }
      }

      const rowValues = [
        roomCode,
        params.playerId,
        params.playerName,
        params.isHost === true || params.isHost === 'true',
        params.isStealthHost === true || params.isStealthHost === 'true',
        params.question !== undefined ? params.question : currentQuestion,
        params.answer !== undefined ? params.answer : '',
        params.status || currentStatus,
        now
      ];

      if (foundRow &gt; 0) {
        if (action === 'join') {
          rowValues[6] = data[foundRow - 1][6];
        }
        sheet.getRange(foundRow, 1, 1, 9).setValues([rowValues]);
      } else {
        sheet.appendRow(rowValues);
      }
    } else if (action === 'setQuestion') {
      for (let i = 1; i &lt; data.length; i++) {
        if (String(data[i][0]).toUpperCase() === roomCode) {
          sheet.getRange(i + 1, 6).setValue(params.question || '');
          sheet.getRange(i + 1, 9).setValue(now);
        }
      }
    } else if (action === 'reveal' || action === 'reset') {
      const newStatus = action === 'reveal' ? 'REVEALED' : 'ANSWERING';
      for (let i = 1; i &lt; data.length; i++) {
        if (String(data[i][0]).toUpperCase() === roomCode) {
          sheet.getRange(i + 1, 8).setValue(newStatus);
          if (action === 'reset') {
            sheet.getRange(i + 1, 7).setValue('');
          }
          sheet.getRange(i + 1, 9).setValue(now);
        }
      }
    }

    const updatedData = sheet.getDataRange().getValues();
    const roomPlayers = [];
    let roomQuestion = '等待房主發布題目...';
    let roomStatus = 'ANSWERING';

    for (let i = 1; i &lt; updatedData.length; i++) {
      if (String(updatedData[i][0]).toUpperCase() === roomCode) {
        if (updatedData[i][5]) roomQuestion = updatedData[i][5];
        if (updatedData[i][7]) roomStatus = updatedData[i][7];
        roomPlayers.push({
          roomCode: updatedData[i][0],
          playerId: updatedData[i][1],
          playerName: updatedData[i][2],
          isHost: updatedData[i][3] === true || updatedData[i][3] === 'true',
          isStealthHost: updatedData[i][4] === true || updatedData[i][4] === 'true',
          question: updatedData[i][5],
          answer: updatedData[i][6],
          status: updatedData[i][7],
          updatedAt: updatedData[i][8]
        });
      }
    }

    return ContentService.createTextOutput(JSON.stringify({
      ok: true,
      roomCode: roomCode,
      question: roomQuestion,
      status: roomStatus,
      players: roomPlayers
    })).setMimeType(ContentService.MimeType.JSON);

  } catch (err) {
    return ContentService.createTextOutput(JSON.stringify({
      ok: false,
      error: err.toString()
    })).setMimeType(ContentService.MimeType.JSON);
  } finally {
    lock.releaseLock();
  }
}</pre>
