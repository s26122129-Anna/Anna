                        </div>
                    </div>

                    <button id="joinRoomBtn" onclick="handleJoinRoom()" 
                        class="w-full py-3.5 px-5 rounded-xl bg-tactical-panelLight hover:bg-tactical-accent/20 text-tactical-cyan border border-tactical-accent/60 font-bold tracking-wide transition duration-200 flex items-center justify-center gap-2">
                        <span>接入指定房間</span>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
