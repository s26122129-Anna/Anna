                                <button type="button" onclick="prefillRandomHostRoomCode()" class="text-[11px] font-mono text-tactical-cyan hover:underline">
                                    隨機產生 5 碼
                                </button>
                            </div>
                            <input type="text" id="customHostRoomCodeInput" maxlength="8" placeholder="留空自動產生 (例如：ALPHA)" 
