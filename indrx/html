<title>雲端心電感應 | CLOUD TELEPATHY</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Inter & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;700&family=Noto+Sans+TC:wght@300;400;500;700&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        tactical: {
                            bg: '#0b0c10',
                            panel: '#1f2833',
                            panelLight: '#26313f',
                            accent: '#45a29e',
                            cyan: '#66fcf1',
                            text: '#c5c6c7',
                            muted: '#88929b',
                            danger: '#ff4d4d',
                            warning: '#f59e0b'
                        }
                    },
                    fontFamily: {
                        sans: ['"Inter"', '"Noto Sans TC"', 'sans-serif'],
                        mono: ['"JetBrains Mono"', 'monospace'],
                    }
                }
            }
        }
    </script>

    <style>
        /* 全域背景與戰術網格紋理 */
        body {
            background-color: #0b0c10;
            color: #c5c6c7;
            background-image: 
                linear-gradient(to right, rgba(69, 162, 158, 0.04) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(69, 162, 158, 0.04) 1px, transparent 1px);
            background-size: 36px 36px;
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* 戰術邊框與微光效應 */
        .tactical-panel {
            background: rgba(31, 40, 51, 0.85);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(69, 162, 158, 0.25);
            box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.7);
        }

        .tactical-panel-glow {
            border-color: rgba(102, 252, 241, 0.5);
            box-shadow: 0 0 20px rgba(69, 162, 158, 0.15);
        }

        .tactical-input {
            background-color: #0b0c10;
            border: 1px solid rgba(69, 162, 158, 0.35);
            color: #ffffff;
            transition: all 0.25s ease;
        }

        .tactical-input:focus {
            outline: none;
            border-color: #66fcf1;
            box-shadow: 0 0 0 2px rgba(102, 252, 241, 0.15);
        }

        /* 3D 翻牌核心樣式 */
        .perspective-container {
            perspective: 1200px;
        }

        .flip-card-inner {
            position: relative;
            width: 100%;
            height: 100%;
            transition: transform 0.85s cubic-bezier(0.22, 1, 0.36, 1);
            transform-style: preserve-3d;
        }

        .flip-card.is-flipped .flip-card-inner {
            transform: rotateY(180deg);
        }

        .flip-card-front,
        .flip-card-back {
            position: absolute;
            width: 100%;
            height: 100%;
            -webkit-backface-visibility: hidden;
            backface-visibility: hidden;
            border-radius: 0.75rem;
            overflow: hidden;
        }

        /* 牌背：未開牌狀態 (預設正面朝向使用者 0deg) */
        .flip-card-front {
            background: linear-gradient(145deg, #161d26 0%, #0e1217 100%);
            border: 1px solid rgba(69, 162, 158, 0.3);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        /* 牌背加密幾何條紋 */
        .classified-pattern {
            background-image: repeating-linear-gradient(
                -45deg,
                rgba(69, 162, 158, 0.05),
                rgba(69, 162, 158, 0.05) 8px,
                transparent 8px,
                transparent 16px
            );
        }

        /* 牌面：開牌後揭曉答案 (旋轉 180deg) */
        .flip-card-back {
            background: linear-gradient(160deg, #1f2833 0%, #131920 100%);
            border: 1px solid #45a29e;
            transform: rotateY(180deg);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            box-shadow: 0 0 25px rgba(69, 162, 158, 0.18);
        }

        /* 默契最高一致答案高亮 */
        .flip-card-back.match-highlight {
            border-color: #66fcf1;
            box-shadow: 0 0 28px rgba(102, 252, 241, 0.32);
            background: linear-gradient(160deg, #1f3338 0%, #111b21 100%);
        }

        /* 自訂捲軸 */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #0b0c10;
        }
        ::-webkit-scrollbar-thumb {
            background: #2c3947;
            border-radius: 3px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #45a29e;
        }
    </style>
</head>
<body class="antialiased selection:bg-tactical-accent selection:text-tactical-bg flex flex-col">

    <!-- 頂部戰術狀態導航列 -->
