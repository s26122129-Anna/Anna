                    <button type="button" onclick="generateRandomCallsign()" title="隨機產生戰術代號" 
                        class="absolute right-2.5 top-1/2 -translate-y-1/2 px-2.5 py-1.5 rounded-lg bg-tactical-panel hover:bg-tactical-accent/20 border border-tactical-accent/30 text-xs font-mono text-tactical-cyan transition">
                        隨機代號
                    </button>
                </div>
            </div>

            <!-- 步驟 2：分流選擇 (建立房間 vs 加入房間) -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8">
                
                <!-- 左側卡片：房主建立戰術房間 -->
