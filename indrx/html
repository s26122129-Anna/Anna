    <!-- ==================== 核心 JavaScript 邏輯 ==================== -->
    <script>
        /**
         * 系統核心常數設定 (依照需求指定)
         */
        const SHEET_NAME = 'TelepathyData';
        const GAS_API_URL = "https://docs.google.com/spreadsheets/d/1WBfngnbCamQnltrmkdr_HSvKlV4yULE7FbD_ea43SnU/edit?usp=sharing";
        const POLLING_INTERVAL_MS = 2500;

        /**
         * 判斷網址是否為合法部署的 GAS Web App (/exec) 端點
         */
        function isValidGasExecUrl(url) {
            if (!url || typeof url !== 'string') return false;
            const trimmed = url.trim();
            return /^https:\/\/script\.google\.com\/macros\/s\/[^/]+\/exec(\?.*)?$/i.test(trimmed);
        }

        /**
         * 應用程式全域狀態
         */
        const savedCustomUrl = localStorage.getItem('telepathy_custom_gas_url') || '';
        const initialActiveUrl = isValidGasExecUrl(savedCustomUrl) ? savedCustomUrl : GAS_API_URL;

        const state = {
            activeGasUrl: initialActiveUrl,
            useLocalDemoMode: !isValidGasExecUrl(initialActiveUrl),
            roomCode: '',
            playerId: '',
            playerName: '',
            isHost: false,
            isStealthHost: false,
            question: '等待房主發布題目...',
            status: 'ANSWERING', // 'ANSWERING' | 'REVEALED'
            players: [],
            pollingTimer: null,
            broadcastChannel: null,
            isSyncing: false,
            lastRenderedSignature: ''
        };

        /**
         * 初始化：檢查 GAS 端點有效性、建立 BroadcastChannel 多分頁即時通道、檢查 URL ?room= 參數
         */
        window.addEventListener('DOMContentLoaded', () => {
            updateConnBadgeUI();
            const urlInput = document.getElementById('gasUrlConfigInput');
            if (urlInput) urlInput.value = state.activeGasUrl;

            // 生成獨立的瀏覽器分頁/裝置識別碼
            let storedId = sessionStorage.getItem('telepathy_player_id');
            if (!storedId) {
                storedId = 'OP-' + Math.random().toString(36).substring(2, 8).toUpperCase();
                sessionStorage.setItem('telepathy_player_id', storedId);
            }
            state.playerId = storedId;

            // 建立 BroadcastChannel 讓同瀏覽器多分頁在本機模式下毫秒級即時同步
            if ('BroadcastChannel' in window) {
                state.broadcastChannel = new BroadcastChannel('cloud_telepathy_sync');
                state.broadcastChannel.onmessage = (event) => {
                    if (state.useLocalDemoMode && event.data && event.data.roomCode === state.roomCode) {
                        syncRoomState(false);
                    }
                };
            }

            // 檢查 URL 參數自動填入房號
            const urlParams = new URLSearchParams(window.location.search);
            const roomParam = urlParams.get('room');
            if (roomParam) {
                document.getElementById('roomCodeInput').value = roomParam.toUpperCase();
                showToast(`偵測到邀請頻道代碼：${roomParam.toUpperCase()}，請輸入代號後加入`, 'info');
            }

            // 支援 Enter 鍵送出答案與題目
            document.getElementById('myAnswerInput').addEventListener('keydown', (e) => {
                if (e.key === 'Enter') submitMyAnswer();
            });
            document.getElementById('hostQuestionInput').addEventListener('keydown', (e) => {
                if (e.key === 'Enter') publishQuestion();
            });
        });

        /**
         * 儲存並套用使用者自訂的 GAS Web App /exec 網址
         */
        function saveCustomGasUrl() {
            const inputEl = document.getElementById('gasUrlConfigInput');
            const newUrl = inputEl.value.trim();

            if (!newUrl) {
                localStorage.removeItem('telepathy_custom_gas_url');
                state.activeGasUrl = GAS_API_URL;
                state.useLocalDemoMode = !isValidGasExecUrl(GAS_API_URL);
                updateConnBadgeUI();
                showToast('已重設為預設端點設定', 'info');
                return;
            }

            state.activeGasUrl = newUrl;
            localStorage.setItem('telepathy_custom_gas_url', newUrl);

            if (isValidGasExecUrl(newUrl)) {
                state.useLocalDemoMode = false;
                updateConnBadgeUI();
                showToast('已偵測到有效 GAS /exec 端點，切換至雲端同步模式！', 'success');
                if (state.roomCode) manualSync();
            } else {
                state.useLocalDemoMode = true;
                updateConnBadgeUI();
                showToast('此網址非 /exec 部署端點，維持「本機多開模擬同步模式」', 'warning');
            }
        }

        function prefillRandomHostRoomCode() {
            document.getElementById('customHostRoomCodeInput').value = generateRoomCode();
        }

        /**
         * 切換 GAS 雲端連線模式 與 本機多開測試模式
         */
        function toggleConnectionMode() {
            state.useLocalDemoMode = !state.useLocalDemoMode;
            const label = document.getElementById('connModeLabel');
            const dot = document.getElementById('connStatusDot');

            if (state.useLocalDemoMode) {
                label.textContent = '本機多開測試模式';
                dot.className = 'w-2 h-2 rounded-full bg-amber-400 animate-pulse';
                showToast('已切換至「本機多開測試模式」（支援同瀏覽器開多個分頁同步測試）', 'warning');
            } else {
                label.textContent = 'GAS 雲端連線';
                dot.className = 'w-2 h-2 rounded-full bg-tactical-cyan animate-pulse';
                showToast('已切換至「GAS 雲端連線模式」', 'success');
            }

            if (state.roomCode) {
                manualSync();
            }
        }

        /**
         * 隨機產生酷炫戰術代號
         */
        function generateRandomCallsign() {
            const prefixes = ['夜鷹', '獵隼', '幽靈', '暗影', '零號', '極光', '星塵', '銀狐', '寒霜', '雷霆'];
            const suffix = Math.floor(10 + Math.random() * 89);
            const randomName = prefixes[Math.floor(Math.random() * prefixes.length)] + '-' + suffix;
            document.getElementById('playerNameInput').value = randomName;
        }

        /**
         * 產生 5 碼大寫英數房間代碼
         */
        function generateRoomCode() {
            const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
            let code = '';
            for (let i = 0; i < 5; i++) {
                code += chars.charAt(Math.floor(Math.random() * chars.length));
            }
            return code;
        }

        /**
         * 房主建立房間流程
         */
        async function handleCreateRoom() {
            const nameInput = document.getElementById('playerNameInput').value.trim();
            if (!nameInput) {
                showToast('請先輸入您的行動代號！', 'warning');
                document.getElementById('playerNameInput').focus();
                return;
            }

            const customCodeRaw = document.getElementById('customHostRoomCodeInput').value.trim().toUpperCase().replace(/[^A-Z0-9-]/g, '');
            const newRoomCode = customCodeRaw.length >= 3 ? customCodeRaw : generateRoomCode();
            const isStealth = document.getElementById('stealthHostCheckbox').checked;

            state.playerName = nameInput;
            state.roomCode = newRoomCode;
            state.isHost = true;
            state.isStealthHost = isStealth;
            state.question = '等待房主發布題目...';
            state.status = 'ANSWERING';

            setButtonLoading('createRoomBtn', true, '建立頻道中...');
            try {
                await apiRequest('join', {
                    question: state.question,
                    answer: '',
                    status: 'ANSWERING'
                });
                enterRoomUI();
                showToast(`已建立戰術頻道 ${newRoomCode}${isStealth ? '（隱身房主模式）' : ''}`, 'success');
            } catch (err) {
                showToast('雲端連線異常，已自動切換至本機多開模擬模式建立房間', 'warning');
                state.useLocalDemoMode = true;
                updateConnBadgeUI();
                await apiRequest('join', { question: state.question, answer: '', status: 'ANSWERING' });
                enterRoomUI();
            } finally {
                setButtonLoading('createRoomBtn', false, '產生房號並建立頻道');
            }
        }

        /**
         * 資料存取層：支援 Google Apps Script Fetch (GET/POST text/plain) 與 LocalStorage + BroadcastChannel 多分頁測試
         */
        async function apiRequest(action, extraPayload = {}) {
            const payload = {
                action: action,
                sheetName: SHEET_NAME,
                roomCode: state.roomCode,
                playerId: state.playerId,
                playerName: state.playerName,
                isHost: state.isHost,
                isStealthHost: state.isStealthHost,
                ...extraPayload
            };

            // 若 GAS_API_URL 仍為試算表編輯網址或無效 /exec，使用本機多開模擬同步模式
            if (state.useLocalDemoMode || !isValidGasExecUrl(state.activeGasUrl)) {
                return handleLocalStorageMock(payload);
            }

            const controller = new AbortController();
            const timeoutId = setTimeout(() => controller.abort(), 8000);

            try {
                let response;
                if (action === 'sync') {
                    const url = new URL(state.activeGasUrl);
                    url.searchParams.append('action', 'sync');
                    url.searchParams.append('sheetName', SHEET_NAME);
                    url.searchParams.append('roomCode', state.roomCode);
                    response = await fetch(url.toString(), {
                        method: 'GET',
                        signal: controller.signal
                    });
                } else {
                    // 使用 text/plain 避開 GAS CORS OPTIONS Preflight 限制
                    response = await fetch(state.activeGasUrl, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'text/plain;charset=utf-8'
                        },
                        body: JSON.stringify(payload),
                        signal: controller.signal
                    });
                }
                clearTimeout(timeoutId);

                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                const data = await response.json();
                return data;
            } catch (error) {
                clearTimeout(timeoutId);
                throw error;
            }
        }

        /**
         * 本機多開模擬資料庫 (支援同瀏覽器多分頁透過 localStorage + BroadcastChannel 即時連動)
         */
        function handleLocalStorageMock(payload) {
            const storageKey = `telepathy_mock_${payload.roomCode}`;
            let roomData = JSON.parse(localStorage.getItem(storageKey) || 'null');

            if (!roomData) {
                roomData = {
                    roomCode: payload.roomCode,
                    question: payload.question || '等待房主發布題目...',
                    status: 'ANSWERING',
                    players: []
                };
            }

            const idx = roomData.players.findIndex(p => p.playerId === payload.playerId);
            let mutated = false;

            if (payload.action === 'join') {
                if (idx === -1) {
                    roomData.players.push({
                        roomCode: payload.roomCode,
                        playerId: payload.playerId,
                        playerName: payload.playerName,
                        isHost: payload.isHost,
                        isStealthHost: payload.isStealthHost,
                        answer: '',
                        status: roomData.status
                    });
                } else {
                    roomData.players[idx].playerName = payload.playerName;
                    roomData.players[idx].isHost = payload.isHost;
                    roomData.players[idx].isStealthHost = payload.isStealthHost;
                }
                mutated = true;
            } else if (payload.action === 'setQuestion') {
                roomData.question = payload.question;
                mutated = true;
            } else if (payload.action === 'answer') {
                if (idx !== -1) {
                    roomData.players[idx].answer = payload.answer;
                    mutated = true;
                }
            } else if (payload.action === 'reveal') {
                roomData.status = 'REVEALED';
                mutated = true;
            } else if (payload.action === 'reset') {
                roomData.status = 'ANSWERING';
                roomData.players.forEach(p => p.answer = '');
                mutated = true;
            }

            if (mutated) {
                localStorage.setItem(storageKey, JSON.stringify(roomData));
                if (state.broadcastChannel) {
                    state.broadcastChannel.postMessage({ roomCode: payload.roomCode, action: payload.action });
                }
            }

            return Promise.resolve({
                ok: true,
                roomCode: roomData.roomCode,
                question: roomData.question,
                status: roomData.status,
                players: roomData.players
            });
        }

        /**
         * 複製房號與專屬邀請網址 (使用 execCommand 相容 iFrame 環境)
         */
        function copyRoomCode() {
            const shareUrl = `${window.location.origin}${window.location.pathname}?room=${state.roomCode}`;
            const textToCopy = `加入我的《雲端心電感應》戰術頻道！房間代碼：${state.roomCode}\n快速連結：${shareUrl}`;

            const tempTextarea = document.createElement('textarea');
            tempTextarea.value = textToCopy;
            document.body.appendChild(tempTextarea);
            tempTextarea.select();
            try {
                document.execCommand('copy');
                showToast(`已複製房間代碼「${state.roomCode}」與邀請連結！`, 'success');
            } catch (err) {
                showToast(`房間代碼：${state.roomCode}`, 'info');
            }
            document.body.removeChild(tempTextarea);
        }

        /**
         * GAS 程式碼檢視彈窗控制
         */
        function openGasModal() {
            document.getElementById('gasModal').classList.remove('hidden');
        }

        function closeGasModal() {
            document.getElementById('gasModal').classList.add('hidden');
        }

        function copyGasCode() {
            const codeText = document.getElementById('gasCodeBlock').textContent;
            const tempTextarea = document.createElement('textarea');
            tempTextarea.value = codeText;
            document.body.appendChild(tempTextarea);
            tempTextarea.select();
            try {
                document.execCommand('copy');
                showToast('已複製 Google Apps Script 後端程式碼！', 'success');
            } catch (err) {
                showToast('複製失敗，請手動選取複製', 'warning');
            }
            document.body.removeChild(tempTextarea);
        }

        /**
         * 輔助工具函式
         */
        function updateConnBadgeUI() {
            const label = document.getElementById('connModeLabel');
            const dot = document.getElementById('connStatusDot');
            const modalBadge = document.getElementById('modalEndpointBadge');

            if (state.useLocalDemoMode) {
                label.textContent = '本機多開模擬同步模式';
                dot.className = 'w-2 h-2 rounded-full bg-amber-400 animate-pulse';
                if (modalBadge) {
                    modalBadge.textContent = '本機多開模擬同步 (LocalStorage + BroadcastChannel)';
                    modalBadge.className = 'text-[11px] font-mono px-2 py-0.5 rounded bg-amber-500/15 text-amber-300 border border-amber-500/30';
                }
            } else {
                label.textContent = 'GAS 雲端同步連線';
                dot.className = 'w-2 h-2 rounded-full bg-tactical-cyan animate-pulse';
                if (modalBadge) {
                    modalBadge.textContent = 'GAS 雲端 /exec 已連線';
                    modalBadge.className = 'text-[11px] font-mono px-2 py-0.5 rounded bg-tactical-cyan/15 text-tactical-cyan border border-tactical-cyan/40';
                }
            }
        }

        function setButtonLoading(btnId, isLoading, text) {
            const btn = document.getElementById(btnId);
            if (!btn) return;
            btn.disabled = isLoading;
            const span = btn.querySelector('span');
            if (span) span.textContent = text;
        }

        function escapeHtml(str) {
            if (str === null || str === undefined) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }
    </script>
