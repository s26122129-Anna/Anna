                        <span id="pollingPulse" class="w-2 h-2 rounded-full bg-tactical-accent"></span>
                        <span id="syncStatusText">輪詢待命 (2.5s)</span>
                    </div>
                    <button onclick="manualSync()" class="px-3 py-1.5 rounded-lg bg-tactical-bg hover:bg-tactical-panelLight border border-tactical-accent/30 text-xs font-mono text-tactical-text hover:text-tactical-cyan transition flex items-center gap-1.5">
